/**
 * @brief AppID to report to the window system on Linux/Wayland.
 *
 * Also used as the macOS bundle identifier.
 */
#define SOLARUSEDITOR_APP_ID "${SOLARUSEDITOR_APP_ID}"

/**
 * @brief Application display name.
 */
#define SOLARUSEDITOR_APP_DISPLAY_NAME "${SOLARUSEDITOR_APP_DISPLAY_NAME}"

/**
 * @brief Executable name.
 */
#define SOLARUSEDITOR_EXECUTABLE_NAME "${SOLARUSEDITOR_EXECUTABLE_NAME}"

/**
 * @brief General application metadata.
 */
#define SOLARUSEDITOR_ORGANISATION "${SOLARUSEDITOR_ORGANISATION}"
#define SOLARUSEDITOR_COPYRIGHT "${SOLARUSEDITOR_COPYRIGHT}"
#define SOLARUSEDITOR_WEBSITE "${SOLARUSEDITOR_WEBSITE}"

/**
 * @brief Whether to disable GUI native dialogs.
 */
#cmakedefine01 SOLARUSEDITOR_NO_NATIVE_DIALOGS

/**
 * @brief Install paths to help find the application assets.
 */
#cmakedefine SOLARUSEDITOR_SOURCE_PATH "${SOLARUSEDITOR_SOURCE_PATH}"
#cmakedefine SOLARUSEDITOR_BINDIR_PATH "${SOLARUSEDITOR_BINDIR_PATH}"
#cmakedefine SOLARUSEDITOR_DATADIR_PATH "${SOLARUSEDITOR_DATADIR_PATH}"
#cmakedefine SOLARUSEDITOR_ASSETS_DIR "${SOLARUSEDITOR_ASSETS_DIR}"
