#define WIN32_LEAN_AND_MEAN
#include <windows.h>

// Sets the code page to UTF-8.
#pragma code_page(65001)

VS_VERSION_INFO VERSIONINFO
FILEVERSION ${PROJECT_VERSION_MAJOR},${PROJECT_VERSION_MINOR},${PROJECT_VERSION_PATCH},${PROJECT_VERSION_TWEAK}
PRODUCTVERSION ${PROJECT_VERSION_MAJOR},${PROJECT_VERSION_MINOR},${PROJECT_VERSION_PATCH},${PROJECT_VERSION_TWEAK}
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS (VS_FF_PRIVATEBUILD|VS_FF_PRERELEASE|VS_FF_DEBUG)
#else
FILEFLAGS 0x0L
#endif
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN

BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", "${SOLARUSLAUNCHER_ORGANISATION}\0"
            VALUE "FileDescription", "${PROJECT_DESCRIPTION}\0"
            VALUE "FileVersion", "${PROJECT_VERSION}\0"
            VALUE "InternalName", "${SOLARUSLAUNCHER_DISPLAY_NAME}\0"
            VALUE "LegalCopyright", "${SOLARUSLAUNCHER_COPYRIGHT}\0"
            VALUE "LegalTrademarks", "${SOLARUSLAUNCHER_TRADEMARKS}\0"
            VALUE "OriginalFilename", "${SOLARUSLAUNCHER_DISPLAY_NAME}.exe\0"
            VALUE "ProductName", "${SOLARUSLAUNCHER_DISPLAY_NAME}\0"
            VALUE "ProductVersion", "${PROJECT_VERSION}\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END

// Define the application's manifest.
ID_MANIFEST RT_MANIFEST "${WINDOWS_APPLICATION_MANIFEST_ABSOLUTE_PATH}"

// Define the application's icon.
IDI_ICON1 ICON DISCARDABLE "${WINDOWS_APPLICATION_ICON_ABSOLUTE_PATH}"
IDI_ICON2 ICON DISCARDABLE "${WINDOWS_FILE_ICON_ABSOLUTE_PATH}"
