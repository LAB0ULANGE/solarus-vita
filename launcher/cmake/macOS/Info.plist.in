<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>CFBundleIdentifier</key>
    <string>@SOLARUSLAUNCHER_APP_IDENTIFIER@</string>
    <key>CFBundleName</key>
    <string>@SOLARUSLAUNCHER_DISPLAY_NAME@</string>
    <key>CFBundleExecutable</key>
    <string>@SOLARUSLAUNCHER_EXECUTABLE_NAME@</string>
    <key>CFBundleIconFile</key>
    <string>@SOLARUSLAUNCHER_MACOS_BUNDLE_ICON_FILE@</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@PROJECT_VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@PROJECT_VERSION@</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>@CMAKE_OSX_DEPLOYMENT_TARGET@</string>
    <key>CFBundleDocumentTypes</key>
    <array>
      <dict>
        <key>CFBundleTypeName</key>
        <string>@SOLARUSLAUNCHER_DOCUMENT_NAME@</string>
        <key>CFBundleTypeRole</key>
        <string>Viewer</string>
        <key>LSHandlerRank</key>
        <string>Owner</string>
        <key>LSItemContentTypes</key>
        <array>
          <string>@SOLARUSLAUNCHER_DOCUMENT_IDENTIFIER@</string>
        </array>
        <key>CFBundleTypeIconFile</key>
        <string>@SOLARUSLAUNCHER_MACOS_DOCUMENT_ICON_FILE@</string>
        <key>CFBundleTypeExtensions</key>
        <array>
          <string>@SOLARUSLAUNCHER_DOCUMENT_EXTENSION@</string>
        </array>
        <key>CFBundleTypeMIMETypes</key>
        <string>application/octet-stream</string>
      </dict>
    </array>
    <key>UTExportedTypeDeclarations</key>
    <array>
      <dict>
        <key>UTTypeIdentifier</key>
        <string>@SOLARUSLAUNCHER_DOCUMENT_IDENTIFIER@</string>
        <key>UTTypeDescription</key>
        <string>@SOLARUSLAUNCHER_DOCUMENT_NAME@</string>
        <key>UTTypeConformsTo</key>
        <array>
          <string>public.data</string>
          <string>public.content</string>
        </array>
        <key>UTTypeTagSpecification</key>
        <dict>
          <key>public.filename-extension</key>
          <array>
            <string>@SOLARUSLAUNCHER_DOCUMENT_EXTENSION@</string>
          </array>
          <key>public.mime-type</key>
          <array>
            <string>application/solarus</string>
          </array>
        </dict>
      </dict>
    </array>
  </dict>
</plist>
